# Copy to ~/.config/zpa/oracle-probe.env and protect it appropriately.
# Example: chmod 600 ~/.config/zpa/oracle-probe.env

ZPA_ORACLE_USER=zpa_probe
ZPA_ORACLE_PASSWORD=zpa_probe
ZPA_ORACLE_CONNECT=localhost:1521/FREEPDB1

ORACLE_CONTAINER=oracle-free
CONTAINER_RUNTIME=podman

# Optional override for the SQL*Plus executable inside the container.
# ORACLE_CONTAINER_CLIENT=sqlplus

# If ORACLE_CONTAINER is unset, the wrapper uses a local client instead.
# ORACLE_CLIENT=sqlplus
